# ── LLM ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings (Ollama — resuelto via Docker service name) ────────────
OLLAMA_HOST=http://ollama:11434
EMBED_MODEL=nomic-embed-text

# ── Base de datos (resuelto via Docker service name) ──────────────────
DATABASE_URL=postgresql+asyncpg://sara:CAMBIA_ESTE_PASSWORD@postgres:5432/sara_db
POSTGRES_PASSWORD=CAMBIA_ESTE_PASSWORD

# ── Qdrant (resuelto via Docker service name) ─────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=sara_memories

# ── Credenciales (montadas como volumen /secrets/) ────────────────────
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-credentials.json
GOOGLE_CREDENTIALS_PATH=/secrets/google-credentials.json

# ── App ───────────────────────────────────────────────────────────────
APP_NAME=SARA
MEMORY_TOP_K=5
PUBLIC_URL=https://api.luismendezdev.online

# ── Mem0 Cloud (opcional — dejar vacío para modo local) ───────────────
MEM0_API_KEY=
